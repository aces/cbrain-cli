#
# This script just creates the
# content of the credentials.json file
# needed by the 'cbrain' command line program;
# the token in there is one of those used
# in the CBRAIN api test framework, only
# valid within the test database set up there.
#
# Writes a multi-session credentials map so
# `cbrain session list` / `cbrain switch_session`
# can flip among planted test users.
#

ADMIN_TOKEN="0123456789abcdef0123456789abcdef";
NORMAL_TOKEN="0123456789abcdeffedcba9876543210";
DEL_TOKEN="0123456789abcdefffffffffffffffff";

cbrain_cred_file=$HOME/.config/cbrain/credentials.json
mkdir -p "$(dirname "$cbrain_cred_file")"

timestamp=$(date +"%Y-%m-%dT%H:%M:%S")
testses="$1"

# Clear credentials (not logged in)
if test "X$testses" = "X" -o "X$testses" = "XNONE" ; then
  rm -f "$cbrain_cred_file"
  exit 0
fi

# Load existing named sessions (if any) so we can add/switch without wiping others.
existing="{}"
if test -s "$cbrain_cred_file" ; then
  existing=$(cat "$cbrain_cred_file")
fi

python3 - "$cbrain_cred_file" "$testses" "$timestamp" "$ADMIN_TOKEN" "$NORMAL_TOKEN" "$DEL_TOKEN" "$existing" <<'PY'
import json, sys

path, name, ts, admin_tok, norm_tok, del_tok, existing_raw = sys.argv[1:8]
try:
    data = json.loads(existing_raw) if existing_raw.strip() else {}
except json.JSONDecodeError:
    data = {}

# Promote legacy flat file to named map.
if "api_token" in data or "cbrain_url" in data:
    if not any(isinstance(v, dict) and "api_token" in v for k, v in data.items() if k != "_active_session"):
        data = {"default": {k: v for k, v in data.items() if k != "_active_session"}}

sessions = {
    "admin": {
        "cbrain_url": "http://localhost:3000",
        "api_token": admin_tok,
        "user_id": 1,
        "username": "admin",
        "timestamp": ts,
    },
    "norm": {
        "cbrain_url": "http://localhost:3000",
        "api_token": norm_tok,
        "user_id": 2,
        "username": "norm",
        "timestamp": ts,
    },
    "normdel": {
        "cbrain_url": "http://localhost:3000",
        "api_token": del_tok,
        "user_id": 2,
        "username": "norm",
        "timestamp": ts,
    },
}

if name not in sessions:
    sys.exit(0)

data[name] = sessions[name]
data["_active_session"] = name
with open(path, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
PY
